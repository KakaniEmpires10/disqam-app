# Server-only. Copy this file to .env; never expose the URL in public runtimeConfig.
DATABASE_URL=

# Guard for db:push. Use development only for a disposable/development database.
# Set production in the production environment; db:push will refuse to run.
DATABASE_ENV=development

# Server-only random secret, at least 32 characters. Keep stable across instances.
NUXT_SESSION_PASSWORD=
# Exact browser origin. HTTPS required in production; no trailing path.
APP_URL=http://localhost:3000
