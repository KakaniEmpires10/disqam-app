<?xml version="1.0" encoding="utf-8"?>
<!-- Android resizes this drawable before masking it. Never use fixed child
     dimensions: they do not scale with the bounds and can crop the mark.
     The entire bitmap fits in a 160 x 102 rectangle on a 288 square canvas;
     its diagonal is below the 192dp circular safe area, even before accounting
     for the original image's transparent margins. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="28%" android:insetRight="28%"
            android:insetTop="28%" android:insetBottom="28%">
            <bitmap android:src="@drawable/disqam_icon" android:gravity="fill" />
        </inset>
    </item>
</layer-list>
